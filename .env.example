JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
NODE_ENV=development
FRONTEND_URL="http://localhost:8080"
BACKEND_URL=http://localhost:5000
PORT=5000

# File Upload Limits
MAX_VIDEO_SIZE_MB=500

# Currency Exchange Rates
USD_TO_KES_RATE=129

# Safaricom Daraja API — STK Push (incoming payments)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox
MPESA_ALLOWED_IPS=

# Safaricom Daraja API — B2C / B2B (outgoing withdrawals)
# Initiator name registered on Daraja portal
MPESA_B2C_INITIATOR_NAME=
# Encrypted security credential (generated from Daraja portal)
MPESA_B2C_SECURITY_CREDENTIAL=
# Your business shortcode (same as MPESA_SHORTCODE for most setups)
MPESA_B2C_SHORT_CODE=

# B2C fee tiers — M-Pesa send money tariff (business pays)
# Amounts are KES thresholds; fees in KES
MPESA_B2C_FEE_TIER_1_MAX=100
MPESA_B2C_FEE_TIER_1_FEE=0
MPESA_B2C_FEE_TIER_2_MAX=500
MPESA_B2C_FEE_TIER_2_FEE=7
MPESA_B2C_FEE_TIER_3_MAX=1000
MPESA_B2C_FEE_TIER_3_FEE=13
MPESA_B2C_FEE_TIER_4_MAX=250000
MPESA_B2C_FEE_TIER_4_FEE=108

# B2B fee — percentage of amount (e.g. 0.0025 = 0.25%)
MPESA_B2B_FEE_RATE=0.0025
# B2B fee cap in KES
MPESA_B2B_FEE_CAP=200
